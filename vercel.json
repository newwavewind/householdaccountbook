{
  "framework": null,
  "installCommand": "npm install && npm ci --prefix web && npm install --prefix server",
  "buildCommand": "npm run build:revenue --prefix server && npm run build --prefix web",
  "outputDirectory": "web/dist",
  "build": {
    "env": {
      "VITE_BASE_PATH": "/",
      "VITE_LEDGER_BACKEND": "supabase",
      "VITE_COMMUNITY_BACKEND": "supabase",
      "VITE_REVENUE_CLOUD": "true"
    }
  },
  "functions": {
    "api/app-revenue/[[...path]].ts": {
      "maxDuration": 300,
      "includeFiles": "server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
