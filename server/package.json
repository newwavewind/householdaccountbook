{
  "name": "gaegyeobu-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:revenue": "tsx watch src/revenueServer.ts",
    "start:revenue": "tsx src/revenueServer.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:revenue": "tsc -p tsconfig.revenue.json && mkdir -p dist/data && cp -f data/google-report-bundle.json dist/data/google-report-bundle.json 2>/dev/null || true",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "migrate:to-supabase": "tsx scripts/migrate-to-supabase.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/functions": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
